{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZChain Wallet",
  "version": "0.1.0",
  "identifier": "dev.zchain.wallet-mvp",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ZChain Wallet — devnet · PLAY · 自托管",
        "width": 1120,
        "height": 800,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  }
}
